# KohakuSSHManager configuration example.
# Copy to .env (git-ignored) or export these in your process environment.
# All variables use the KSM_ prefix. Values shown are the built-in defaults.

# --- Storage ---
# SQLite database path. Parent directory is created automatically.
KSM_DB_PATH=./data/ksm.db

# --- Secrets (optional: zero-config first run auto-generates them) ---
# Both secrets are auto-provisioned on first startup if left unset:
#   KSM_SECRET      -> generated and saved to <data_dir>/secret.key
#   KSM_ADMIN_TOKEN -> generated and saved to <data_dir>/admin_token.txt
# where <data_dir> is the parent directory of KSM_DB_PATH (default ./data).
# The generated values are reused on later boots; the startup banner logs their
# paths. Setting either variable here (or via *_FILE) overrides the file.
# Keep these two DIFFERENT from each other.

# Deployment secret used to derive the AES-256-GCM key that encrypts the SSH
# management private key. Provide inline or via KSM_SECRET_FILE (contents stripped).
KSM_SECRET=
# KSM_SECRET_FILE=/run/secrets/ksm_secret

# Admin login token. Log in with username "__token__" and this value as password.
# Only its bcrypt hash is kept in memory; the plaintext is never logged.
KSM_ADMIN_TOKEN=
# KSM_ADMIN_TOKEN_FILE=/run/secrets/ksm_admin_token

# --- Sessions ---
KSM_SESSION_TTL_HOURS=72

# --- SSH ---
KSM_SSH_CONNECT_TIMEOUT=10
KSM_SSH_COMMAND_TIMEOUT=60
KSM_SCAN_TIMEOUT=3600
KSM_SSH_OUTPUT_LIMIT=1048576

# --- Runner concurrency ---
KSM_MAX_WORKERS=8
KSM_MAX_CONCURRENT_SCANS=2

# --- Audit ---
# 0 = keep audit rows forever.
KSM_AUDIT_RETENTION_DAYS=365

# --- Webhook (optional) ---
# Empty disables webhook delivery.
KSM_WEBHOOK_URL=

# --- Health timer (optional) ---
# Seconds between automatic machine connectivity refreshes; 0 = off.
KSM_HEALTH_INTERVAL=0

# --- Server ---
# Bind address. Default 127.0.0.1 (localhost only). Set to 0.0.0.0 to expose the
# panel on the LAN (the backend and its database need root-equivalent protection).
KSM_HOST=127.0.0.1
KSM_PORT=8000

# --- Frontend ---
# Static SPA build directory served if present (falls back to packaged web_dist).
KSM_FRONTEND_DIST=./frontend/dist

# --- Logging ---
# KSM_LOG_LEVEL=INFO
# KSM_LOG_DIR=./logs
